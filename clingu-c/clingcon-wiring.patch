+//! clingu: parse the value of --cumu-explanation.
+[[nodiscard]] auto parse_cumu_explanation(char const *value) -> CumuExplanation {
+    if (std::strcmp(value, "pointwise") == 0) {
+        return CumuExplanation::Pointwise;
+    }
+    if (std::strcmp(value, "bigstep") == 0) {
+        return CumuExplanation::BigStep;
+    }
+    if (std::strcmp(value, "naive") == 0) {
+        return CumuExplanation::Naive;
+    }
+    if (std::strcmp(value, "mixed") == 0) {
+        return CumuExplanation::Mixed;
+    }
+    throw std::invalid_argument("invalid argument");
+}
+
+[[nodiscard]] auto parser_cumu_explanation(CumuExplanation &dest) -> std::function<bool(const char *)> {
+    return [&dest](char const *value) {
+        dest = parse_cumu_explanation(value);
+        return true;
+    };
+}
