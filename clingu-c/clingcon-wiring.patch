+[[nodiscard]] auto parse_cumulative(AbstractConstraintBuilder &builder, Clingo::TheoryAtom const &atom) -> bool {
+    check_syntax(atom.has_guard(), "Invalid Syntax: &cumu needs a '<= Capacity' guard");
+    auto guard = atom.guard();
+    auto cap = evaluate(guard.second);
+    check_syntax(cap.type() == Clingo::SymbolType::Number, "Invalid Syntax: &cumu capacity must be an integer");
+    check_syntax(cap.number() >= 0, "Invalid Syntax: &cumu capacity must be non-negative");
+    CumulativeElementVec elems;
+    for (auto const &element : atom.elements()) {
+        auto tuple = element.tuple();
+        check_syntax(tuple.size() == 3, "Invalid Syntax: &cumu element must be StartVar,Duration,Demand");
+        // The start must name an integer variable. A number, a string or a
+        // negated term would otherwise be taken as the name of a new, unrelated
+        // variable, and the element would constrain nothing the program refers to.
+        auto start_sym = evaluate(tuple[0]);
+        check_syntax(start_sym.type() == Clingo::SymbolType::Function && start_sym.is_positive() &&
+                         start_sym.name()[0] != '#',
+                     "Invalid Syntax: &cumu start must be an integer variable");
+        auto start = builder.add_variable(start_sym);
+        auto dur = evaluate(tuple[1]);
+        auto demand = evaluate(tuple[2]);
+        check_syntax(dur.type() == Clingo::SymbolType::Number && demand.type() == Clingo::SymbolType::Number,
+                     "Invalid Syntax: &cumu duration/demand must be integers");
+        // Reject meaningless task geometry rather than accepting it silently.
+        // translate() builds the activity variable over [0, demand], so a
+        // NEGATIVE demand inverts that domain: [a <= 0] collapses to TRUE_LIT,
+        // the `lower_bound(a) > 0` activity test can never hold, and the element
+        // becomes inert -- a typo would discard the constraint with no error and
+        // yield a "feasible" schedule that exceeds the cap. Zero demand stays
+        // legal: a task that consumes nothing is meaningful, and ignoring it is
+        // the correct semantics rather than an accident.
+        check_syntax(dur.number() >= 0, "Invalid Syntax: &cumu duration must be non-negative");
+        check_syntax(demand.number() >= 0, "Invalid Syntax: &cumu demand must be non-negative");
+        // Each element's condition gates whether it is an active task. With a
+        // wildcard like flight(D,E,_,X) the grounder emits one element per matched
+        // ground literal (e.g. one per carried-customer count W), all sharing the
+        // same start var; only the element whose condition holds is a real task.
+        auto cond = builder.solver_literal(element.condition_id());
+        elems.push_back(
+            CumulativeElement{start, check_valid_value(dur.number()), check_valid_value(demand.number()), cond});
+    }
+    return builder.add_cumulative(builder.solver_literal(atom.literal()), elems, check_valid_value(cap.number()));
+}
+
 auto parse(AbstractConstraintBuilder &builder, Clingo::TheoryAtoms theory_atoms) -> bool {
     for (auto const &atom : theory_atoms) {
+        // &cumu is supported in rule HEADS only: a body
+        // occurrence would need the complement constraint propagated when the
+        // atom is false, which the propagator does not provide. Reject it.
+        check_syntax(!match(atom.term(), "__cumu_b", 0),
+                     "Invalid Syntax: &cumu may only occur in a rule head (body occurrences are not supported)");
+        if (match(atom.term(), "__cumu_h", 0)) {
+            if (!parse_cumulative(builder, atom)) {
+                return false;
+            }
+            continue;
+        }
         bool is_sum_b = match(atom.term(), "__sum_b", 0);
         bool is_sum_h = match(atom.term(), "__sum_h", 0);
         bool is_diff_b = match(atom.term(), "__diff_b", 0);
